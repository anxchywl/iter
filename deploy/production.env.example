# production environment for the shared host. copy to .env.production in the
# deployment checkout, fill it in, chmod 600, and keep it out of source control

ITER_DOMAIN=iter.anxchywl.dev

# generate each with: openssl rand -hex 32
ITER_DB_PASSWORD=
ITER_ADMIN_TOKEN=

# from @BotFather; the backend uses it only to verify Mini App sign-ins
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=iter_app_bot
# set only if the Mini App was created with /newapp; leave empty for the bot's main Mini App
TELEGRAM_APP_SHORT_NAME=

# numeric Telegram user IDs allowed into /admin, comma separated
OPERATOR_TELEGRAM_IDS=

# daily database dumps kept in /var/backups/iter
BACKUP_KEEP=14

FEEDBACK_ENABLED=false
